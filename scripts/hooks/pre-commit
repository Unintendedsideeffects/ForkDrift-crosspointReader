#!/bin/bash
# Pre-commit hook to auto-format staged C/C++ files and block commits on a failed build.
# This runs BEFORE the commit is created, so formatting changes are included in the commit.
#
# Install: git config core.hooksPath scripts/hooks
# (or copy to .git/hooks/ manually)

set -euo pipefail

REPO_ROOT=$(git rev-parse --show-toplevel)
cd "$REPO_ROOT"

prune_old_local_artifacts() {
    # Keep current build caches intact, but drop stale local CI output and logs.
    find . -maxdepth 1 \
        \( -name '.pio-*-ci' -o -name '.pio-lean-local*' -o -name '.pio-size-*' -o -name '.pio-codex*' \) \
        -type d -mtime +14 -prune -exec rm -rf {} +
    find . -maxdepth 1 \
        \( -name '.pio-*.log' -o -name 'pio.log' \) \
        -type f -mtime +14 -delete
    find . -maxdepth 2 \
        \( -path './.plans/*' -o -path './.copilot-logs/*' \) \
        -mtime +14 -exec rm -rf {} +

    # Prune unused per-env PlatformIO build subdirs (older than 14 days).
    if [ -d "$HOME/.cache/crosspoint-pio-build" ]; then
        find "$HOME/.cache/crosspoint-pio-build" -maxdepth 1 -mindepth 1 -type d \
            -mtime +14 -exec rm -rf {} + 2>/dev/null || true
    fi

    # Prune the SCons CacheDir (crosspoint-pio-cache) when it exceeds 2 GB.
    # SCons has no built-in eviction; we implement LRU by file mtime.
    # ccache (separate dir) self-manages via its own max_size config.
    if [ -d "$HOME/.cache/crosspoint-pio-cache" ] && command -v python3 &>/dev/null; then
        python3 - "$HOME/.cache/crosspoint-pio-cache" 2>/dev/null <<'PY' || true
import os, sys

cache_dir = sys.argv[1]
max_bytes = 2 * 1024 ** 3  # 2 GB

entries = []
for dirpath, _, filenames in os.walk(cache_dir):
    for fname in filenames:
        if fname == "config":
            continue
        fpath = os.path.join(dirpath, fname)
        try:
            st = os.stat(fpath)
            entries.append((st.st_mtime, st.st_size, fpath))
        except OSError:
            pass

total = sum(s for _, s, _ in entries)
if total <= max_bytes:
    sys.exit(0)

entries.sort()  # oldest mtime first
removed = removed_bytes = 0
for mtime, size, fpath in entries:
    if total <= max_bytes:
        break
    try:
        os.unlink(fpath)
        total -= size
        removed += 1
        removed_bytes += size
    except OSError:
        pass

print(f"SCons cache pruned: removed {removed} entries ({removed_bytes // 1024**2} MB), {total // 1024**2} MB remaining")
PY
    fi
}

stage_deleted_tracked_files() {
    git ls-files --deleted -z -- "$@" | xargs -0 -r git add -u --
}

prune_stale_generated_html_headers() {
    if ! command -v python3 &> /dev/null; then
        return
    fi

    python3 - <<'PY'
from pathlib import Path
import re

src_dir = Path("src/network/html")
if not src_dir.exists():
    raise SystemExit


def sanitize_identifier(value: str) -> str:
    value = re.sub(r"[^A-Za-z0-9_]", "_", value)
    if not value or value[0].isdigit():
        value = f"_{value}"
    return value


expected_headers = set()
for source in src_dir.rglob("*"):
    if source.suffix == ".html":
        expected_headers.add(source.with_name(f"{sanitize_identifier(source.stem + 'Html')}.generated.h"))
    elif source.suffix == ".js":
        expected_headers.add(source.with_name(f"{sanitize_identifier(source.stem + 'Js')}.generated.h"))

removed = []
for header in src_dir.rglob("*.generated.h"):
    if header not in expected_headers:
        header.unlink()
        removed.append(str(header))

if removed:
    print("Pruned stale generated header(s):")
    for path in removed:
        print(f"  {path}")
PY

    stage_deleted_tracked_files src/network/html
}

prune_stale_screen_previews() {
    if ! command -v python3 &> /dev/null; then
        return
    fi

    python3 tools/screen-harness/write_preview_manifest.py --prune-only docs/configurator/screen-previews

    stage_deleted_tracked_files docs/configurator/screen-previews
}

prune_old_local_artifacts
prune_stale_generated_html_headers
prune_stale_screen_previews

# When translation YAML files are staged, auto-regenerate I18nKeys.h and
# I18nStrings.h so the committed headers always track the YAML source.
# I18nStrings.cpp is intentionally excluded — it is regenerated at build time
# and must not be committed (enforced by the guard below).
STAGED_YAML=$(git diff --cached --name-only --diff-filter=ACM | grep -E '^lib/I18n/translations/.*\.yaml$' || true)
if [ -n "$STAGED_YAML" ]; then
    if command -v python3 &> /dev/null; then
        python3 scripts/gen_i18n.py lib/I18n/translations lib/I18n/
        git add lib/I18n/I18nKeys.h lib/I18n/I18nStrings.h
        git restore --staged lib/I18n/I18nStrings.cpp 2>/dev/null || true
        echo "Auto-regenerated I18n headers from updated translation YAML"
    else
        echo "Warning: python3 not found, skipping I18n header regeneration"
    fi
fi

# Guard: block staging I18nStrings.cpp without a matching translation YAML change.
# I18nStrings.cpp is generated — committing it as a side-effect of unrelated work
# embeds a stale or accidental snapshot. Always commit the YAML source alongside it
# when translations are intentionally updated.
STAGED_STRINGS=$(git diff --cached --name-only --diff-filter=ACM | grep -F 'lib/I18n/I18nStrings.cpp' || true)
if [ -n "$STAGED_STRINGS" ]; then
    if [ -z "$STAGED_YAML" ]; then
        echo "Error: lib/I18n/I18nStrings.cpp is staged without any translation YAML changes."
        echo "I18nStrings.cpp is generated — do not commit it as a side-effect of unrelated work."
        echo ""
        echo "  To unstage:            git restore --staged lib/I18n/I18nStrings.cpp"
        echo "  To commit deliberately: also stage the YAML in lib/I18n/translations/"
        exit 1
    fi
fi

# Regenerate HTML headers when source HTML or theme tokens are staged.
STAGED_THEME=$(git diff --cached --name-only --diff-filter=ACM | grep -F 'scripts/theme.css' || true)
STAGED_HTML=$(git diff --cached --name-only --diff-filter=ACM | grep -E '^src/.*\.html$' || true)
if [ -n "$STAGED_HTML" ] || [ -n "$STAGED_THEME" ]; then
    if command -v python3 &> /dev/null; then
        python3 scripts/build_html.py
        GEN_HEADERS=()
        while IFS= read -r HTML_FILE; do
            BASE_PATH="${HTML_FILE%.html}"
            GEN_HEADERS+=("${BASE_PATH}Html.generated.h")
        done <<< "$STAGED_HTML"
        # Generated headers are gitignored (built at compile time); skip staging them.
    else
        echo "Warning: python3 not found, skipping HTML header generation"
    fi
fi

# Get staged C/C++ files (excluding lib/EpdFont/builtinFonts/ which are generated)
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(c|cpp|h|hpp)$' | grep -v -E '^lib/EpdFont/builtinFonts/' | grep -v -E '\.generated\.h$' || true)

if [ -n "$STAGED_FILES" ]; then
    # Check if clang-format is available
    if ! command -v clang-format &> /dev/null; then
        echo "Warning: clang-format not found, skipping auto-format"
    else
        # Format each staged file and re-stage it
        for FILE in $STAGED_FILES; do
            if [ -f "$FILE" ]; then
                clang-format -style=file -i "$FILE"
                git add "$FILE"
            fi
        done

        echo "Auto-formatted $(echo "$STAGED_FILES" | wc -w) file(s) with clang-format"
    fi
fi

if ! command -v uv &> /dev/null; then
    echo "Error: uv is required in PATH so the pre-commit build can use the pinned toolchain."
    exit 1
fi

# When CROSSPOINT_PRECOMMIT_PROFILE is explicitly set, generate a custom profile
# and build -e custom. Otherwise build -e default (the full build), which shares
# the SCons cache with normal `pio run` dev builds.
if [ -n "${CROSSPOINT_PRECOMMIT_PROFILE:-}" ]; then
    BUILD_PROFILE="$CROSSPOINT_PRECOMMIT_PROFILE"
    BUILD_CMD=(uv run pio run -e custom)
else
    BUILD_PROFILE="default"
    BUILD_CMD=(uv run pio run)
fi

# Cache build results keyed by staged-tree SHA. `git write-tree` produces the
# tree OID for the current index without modifying anything, so identical
# staged content always hashes to the same key. Include the build profile so
# a custom-profile override gets its own cache slot. We cache both successes
# (skip the 5-minute rebuild) and failures (fail-fast on a known-bad state) —
# set FORCE_BUILD=1 to override.
CACHE_DIR="$REPO_ROOT/.cache/build-results"
mkdir -p "$CACHE_DIR"
STATE_KEY="$(git write-tree)"
CACHE_FILE="$CACHE_DIR/$BUILD_PROFILE-$STATE_KEY"
if [ "${FORCE_BUILD:-0}" != "1" ] && [ -f "$CACHE_FILE" ]; then
    CACHED_EXIT="$(cat "$CACHE_FILE")"
    if [ "$CACHED_EXIT" = "0" ]; then
        echo "Cached: staged state $STATE_KEY already built OK — skipping rebuild."
        echo "Pre-commit checks passed (cached)"
        exit 0
    else
        echo "Cached: staged state $STATE_KEY previously FAILED build (exit $CACHED_EXIT)." >&2
        echo "       Edit source to invalidate the cache, or set FORCE_BUILD=1 to retry." >&2
        exit "$CACHED_EXIT"
    fi
fi

# Serialize against any other concurrent `pio run` (manual shell, other hook,
# another checkout/worktree, agent task). Concurrent builds corrupt two shared
# resources: the build dir (~/.cache/crosspoint-pio-build, shared across
# checkouts via platformio.local.ini) and ~/.platformio's package cache (VCS
# clones race and leave half-installed libdeps). We queue behind the in-flight
# build rather than refuse, so background/agent-driven commits don't fail
# spuriously; the message below makes the wait visible. Manual builds should
# use scripts/pio-locked.sh, which takes the same lock.
LOCKFILE=/tmp/crosspoint-pio-build.lock
LOCK_TIMEOUT="${PIO_LOCK_TIMEOUT:-3600}"
exec 9>"$LOCKFILE"
if ! flock -n 9; then
    echo "pre-commit: waiting for in-flight pio build (lock: $LOCKFILE, timeout ${LOCK_TIMEOUT}s)..."
    if ! flock -w "$LOCK_TIMEOUT" 9; then
        echo "ERROR: timed out after ${LOCK_TIMEOUT}s waiting for $LOCKFILE." >&2
        echo "       A pio build appears stuck; check for orphaned pio processes." >&2
        exit 1
    fi
fi

if [ "$BUILD_PROFILE" != "default" ]; then
    echo "Generating ${BUILD_PROFILE} build profile for pre-commit..."
    uv run python scripts/generate_build_config.py --profile "$BUILD_PROFILE"
fi

echo "Running pre-commit build (${BUILD_PROFILE} profile)..."
set +e
"${BUILD_CMD[@]}"
BUILD_EXIT=$?
set -e
echo "$BUILD_EXIT" > "$CACHE_FILE"
if [ "$BUILD_EXIT" -ne 0 ]; then
    exit "$BUILD_EXIT"
fi

echo "Pre-commit checks passed"
